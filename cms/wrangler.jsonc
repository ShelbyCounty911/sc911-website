{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sc911-cms-spike",
	"account_id": "fd14180882e36accc0cf6a3c42d3c391",
	"main": "./src/worker.ts",
	// Spike: only the workers.dev hostname, which Cloudflare Access protects. No preview URLs (they would bypass Access).
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sc911-cms-spike",
			"database_id": "c6c1d43d-dacd-406a-9ed7-c812cc3c8188",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "sc911-cms-spike-media",
		},
	],
	// Co-editing rooms, one Durable Object per entry being edited
	"durable_objects": {
		"bindings": [
			{
				"name": "EMDASH_ROOMS",
				"class_name": "EmDashRoom"
			}
		],
	},
	"exports": {
		"EmDashRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		},
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
	// Production: the Worker sc911-cms, with its own database and file storage (runbook decision D1).
	// Workers Builds for sc911-cms sets the build variable CLOUDFLARE_ENV=production, which selects this
	// environment and builds the indexable site (cms/scripts/site-env.mjs). The test site above is unchanged.
	// workers_dev stays on for admin setup before cutover; Access must protect it before the first deploy.
	// No "routes" here: the shelbycounty911.org/* route is added by hand at cutover (docs/LAUNCH-RUNBOOK.md).
	"env": {
		"production": {
			"name": "sc911-cms",
			"workers_dev": true,
			"preview_urls": false,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "sc911-cms",
					// Replace with the ID of the D1 database "sc911-cms" once it is created.
					"database_id": "00000000-0000-0000-0000-000000000000",
				},
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "sc911-cms-media",
				},
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "EMDASH_ROOMS",
						"class_name": "EmDashRoom"
					}
				],
			},
		},
	},
}