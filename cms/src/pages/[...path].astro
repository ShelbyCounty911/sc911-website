---
// Serves the approved pages (generated from ../site by scripts/build-static.mjs) at their new URLs.
// Pages backed by an EmDash collection are filled in at request time; if the collection can't be
// read, the approved static page is served unchanged.
import { getEmDashCollection } from "emdash";
import pages from "../generated/static-pages.json";
import { entryToMeeting, entryToAudit, injectMeetings } from "../lib/meetings.js";
import { injectTrainings, injectJobs, injectRfps } from "../lib/listings.js";

const raw = Astro.params.path ?? "";
const key = raw === "" ? "/" : `/${raw.replace(/\/+$/, "")}/`;
const page = pages[key];
const headers = { "Content-Type": "text/html; charset=utf-8", "X-Robots-Tag": "noindex, nofollow, noarchive" };

if (!page) {
	return new Response(pages["404"].html, { status: 404, headers });
}
if (raw !== "" && !Astro.url.pathname.endsWith("/")) {
	return Astro.redirect(`${key}${Astro.url.search}`, 301);
}

const path = key.replace(/^\/es\//, "/");
const DYNAMIC = {
	"/meetings/": { collection: "meetings", inject: (html, entries, lang, locals) => injectMeetings(html, entries.map((e) => entryToMeeting(e, locals)), "upcoming", lang) },
	"/records/": {
		collection: "meetings",
		also: "audits",
		inject: (html, entries, lang, locals, audits) =>
			injectMeetings(html, entries.map((e) => entryToMeeting(e, locals)), "records", lang, audits.map((e) => entryToAudit(e, locals))),
	},
	"/training/": { collection: "trainings", inject: (html, entries, lang) => injectTrainings(html, entries, lang) },
	"/careers/": { collection: "psap_jobs", inject: (html, entries, lang) => injectJobs(html, entries, lang) },
	"/rfps/": { collection: "rfps", inject: (html, entries, lang, locals) => injectRfps(html, entries, lang, locals) },
};
const dynamic = DYNAMIC[path];
if (!dynamic) {
	return new Response(page.html, { headers });
}

let entries;
let extra = [];
try {
	({ entries } = await getEmDashCollection(dynamic.collection, { status: "published", limit: 1000 }));
	if (dynamic.also) ({ entries: extra } = await getEmDashCollection(dynamic.also, { status: "published", limit: 1000 }));
} catch (err) {
	console.error(`${dynamic.collection} read failed; serving static page`, err);
	return new Response(page.html, { headers });
}
const res = dynamic.inject(page.html, entries, page.lang, Astro.locals, extra);
return new Response(res.body, { headers: { ...headers, "Cache-Control": "public, max-age=0, must-revalidate" } });
---
