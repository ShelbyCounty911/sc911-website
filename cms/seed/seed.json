        {
          "slug": "recording_url",
          "label": "Recording link (https)",
          "type": "url"
        },
        {
          "slug": "agenda",
          "label": "Agenda (PDF)",
          "type": "file"
        },
        {
          "slug": "material_1",
          "label": "Supporting material 1 (PDF)",
          "type": "file"
        },
        {
          "slug": "material_2",
          "label": "Supporting material 2 (PDF)",
          "type": "file"
        },
        {
          "slug": "material_3",
          "label": "Supporting material 3 (PDF)",
          "type": "file"
        },
        {
          "slug": "material_4",
          "label": "Supporting material 4 (PDF)",
          "type": "file"
        },
        {
          "slug": "material_5",
          "label": "Supporting material 5 (PDF)",
          "type": "file"
        },
        {
          "slug": "minutes",
          "label": "Approved minutes (PDF)",
          "type": "file"
        },
        {
          "slug": "note_en",
          "label": "Public note (English)",
          "type": "text"
        },
        {
          "slug": "note_es",
          "label": "Public note (Spanish)",
          "type": "text"
        }
      ]
    },
