        },
        {
          "slug": "questions_due",
          "label": "Questions due (Central time)",
          "type": "datetime"
        },
        {
          "slug": "due",
          "label": "Proposals due (Central time)",
          "type": "datetime",
          "required": true
        },
        {
          "slug": "summary_en",
          "label": "Summary (English)",
          "type": "text"
        },
        {
          "slug": "summary_es",
          "label": "Summary (Spanish)",
          "type": "text"
        },
        {
          "slug": "contact",
          "label": "Procurement contact (name, email)",
          "type": "text"
        },
        {
          "slug": "solicitation",
          "label": "Solicitation document (PDF)",
          "type": "file"
        },
        {
          "slug": "addendum_1",
          "label": "Addendum 1 (PDF)",
          "type": "file"
        },
        {
          "slug": "addendum_2",
          "label": "Addendum 2 (PDF)",
          "type": "file"
        },
        {
          "slug": "addendum_3",
          "label": "Addendum 3 (PDF)",
          "type": "file"
        },
        {
          "slug": "award_notice",
          "label": "Award notice (PDF)",
