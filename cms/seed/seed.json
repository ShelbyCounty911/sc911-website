          "type": "datetime",
          "required": true
        },
        {
          "slug": "location",
          "label": "Location (one line per address line)",
          "type": "text"
        },
        {
          "slug": "registration_url",
          "label": "Registration or event information link (https)",
          "type": "url"
        },
        {
          "slug": "description_en",
          "label": "Description (English)",
          "type": "text"
        },
        {
          "slug": "description_es",
          "label": "Description (Spanish)",
          "type": "text"
        },
        {
          "slug": "objectives_en",
          "label": "What you will learn (English, one per line)",
          "type": "text"
        },
        {
          "slug": "objectives_es",
          "label": "What you will learn (Spanish, one per line)",
          "type": "text"
        }
      ]
    },
    {
      "slug": "psap_jobs",
      "label": "9-1-1 center jobs (other agencies)",
      "labelSingular": "9-1-1 center job",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Position title (as the agency posts it, English)",
          "type": "string",
          "required": true
        },
        {
          "slug": "agency",
          "label": "Hiring agency (not the District)",
          "type": "select",
          "required": true,
          "validation": {
            "options": [
              "Memphis Police Department",
              "Memphis Fire Services",
              "Shelby County Sheriff's Office"
            ]
          }
        },
        {
          "slug": "pay_en",
          "label": "Pay (English, e.g. $56,190 / year)",
          "type": "string"
        },
        {
          "slug": "pay_es",
          "label": "Pay (Spanish, e.g. $56,190 al año)",
          "type": "string"
        },
        {
          "slug": "employment_type",
          "label": "Employment type",
          "type": "select",
          "required": false,
          "validation": {
            "options": [
              "Full time",
              "Part time"
            ]
          }
        },
        {
          "slug": "location",
          "label": "Work location (e.g. Memphis, TN)",
          "type": "string"
        },
        {
          "slug": "summary_en",
          "label": "Summary (English)",
          "type": "text"
        },
        {
          "slug": "summary_es",
          "label": "Summary (Spanish)",
          "type": "text"
        },
        {
          "slug": "apply_url",
          "label": "Apply link (agency's own posting, https)",
          "type": "url",
          "required": true
        },
        {
          "slug": "info_url",
          "label": "More information link (https, optional)",
          "type": "url"
        },
        {
          "slug": "info_label_en",
          "label": "More information button text (English; blank = More information)",
          "type": "string"
        },
        {
          "slug": "info_label_es",
          "label": "More information button text (Spanish; blank = Más información)",
          "type": "string"
        },
        {
          "slug": "closing",
          "label": "Closing date (leaves the page the day after). Blank = no closing date",
          "type": "datetime"
        },
        {
          "slug": "continuous",
          "label": "Continuous posting (shown when there is no closing date)",
          "type": "boolean"
        }
      ]
    },
    {
      "slug": "rfps",
      "label": "RFPs",
      "labelSingular": "RFP",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title (English)",
          "type": "string",
          "required": true
        },
        {
          "slug": "title_es",
          "label": "Title (Spanish; blank = English title)",
