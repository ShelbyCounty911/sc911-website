{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "SC911",
    "description": "Shelby County, TN Emergency Communications District public site",
    "author": "Shelby County 911 District"
  },
  "settings": {
    "title": "Shelby County, TN Emergency Communications District",
    "tagline": "When life is on the line"
  },
  "collections": [
    {
      "slug": "meetings",
      "label": "Meetings",
      "labelSingular": "Meeting",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Internal title (e.g. Board 2026-12-03)",
          "type": "string",
          "required": true
        },
        {
          "slug": "body",
          "label": "Body",
          "type": "select",
          "required": true,
          "validation": {
            "options": [
              "Board of Directors",
              "Executive Committee"
            ]
          }
        },
        {
          "slug": "start",
          "label": "Start (Central time)",
          "type": "datetime",
          "required": true
        },
        {
          "slug": "end",
          "label": "End (Central time)",
          "type": "datetime",
          "required": true
        },
        {
          "slug": "meeting_status",
          "label": "Status",
          "type": "select",
          "required": true,
          "validation": {
            "options": [
              "Scheduled",
              "Rescheduled",
              "Canceled"
            ]
          }
        },
        {
          "slug": "original_start",
          "label": "Original start, Central time (set when rescheduled)",
          "type": "datetime"
        },
        {
          "slug": "location_name",
          "label": "Location name (blank = District office)",
          "type": "string"
        },
        {
          "slug": "location_address",
          "label": "Location address",
          "type": "text"
        },
        {
          "slug": "online_url",
          "label": "Online attendance link (https)",
