      "slug": "trainings",
      "label": "Trainings",
      "labelSingular": "Training",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title (English)",
          "type": "string",
          "required": true
        },
        {
          "slug": "title_es",
          "label": "Title (Spanish; blank = English title)",
          "type": "string"
        },
        {
          "slug": "kind",
          "label": "Type",
          "type": "select",
          "required": true,
          "validation": {
            "options": [
              "Training class",
              "Conference"
            ]
          }
        },
        {
          "slug": "training_status",
          "label": "Status",
          "type": "select",
          "required": true,
          "validation": {
            "options": [
              "Scheduled",
              "Canceled"
            ]
          }
        },
